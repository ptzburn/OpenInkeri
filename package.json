{
  "name": "openinkeri",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "deploy": "vp build && wrangler deploy",
    "serve": "vp preview",
    "test": "vp test",
    "lint": "vp lint src",
    "check": "paraglide-js compile --silent && vp check",
    "cf-typegen": "wrangler types --env-file=/dev/null",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "auth generate --config auth.cli.ts --output src/server/database/auth-schema.ts --yes",
    "check:i18n": "inlang check --project ./project.inlang"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.38",
    "@solidjs/web": "^2.0.0-rc.14",
    "better-auth": "1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "maplibre-gl": "^6.16.0",
    "solid-js": "^2.0.0-rc.14",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@iconify-json/ri": "^1.2.10",
    "@inlang/cli": "^3.4.2",
    "@inlang/paraglide-js": "^2.27.0",
    "@solidjs/diagnostics": "^2.0.0-rc.14",
    "@solidjs/start-devtools": "^1.0.0-next.4",
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "^3.0.0-next.48",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.2.0",
    "auth": "1.7.7",
    "daisyui": "^5.7.47",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint-plugin-solid": "~0.18.1",
    "filesystem-routing": "0.4.0",
    "jsdom": "^25.0.1",
    "lefthook": "^2.2.1",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "unplugin-icons": "^24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.10.1"
