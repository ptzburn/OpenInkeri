{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genealogy",
  // Solid's virtual Fetchable SSR entry (see README "Cloudflare Workers").
  "main": "virtual:solid-ssr-handler",
  "compatibility_date": "2026-10-06",
  // node:async_hooks for the per-request scope; Worker vars via process.env.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
}
