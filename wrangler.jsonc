{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openinkeri",
  // Solid's virtual Fetchable SSR entry (see README "Cloudflare Workers").
  "main": "virtual:solid-ssr-handler",
  "compatibility_date": "2026-10-06",
  // node:async_hooks for the per-request scope; Worker vars via process.env.
  "compatibility_flags": ["nodejs_compat"],
  // The production hostname. Deploy creates the DNS record and certificate
  // (hokkanen.io is a zone on this account). The workers.dev URL stays on.
  // A new hostname also goes in baseURL.allowedHosts (src/server/auth-options.ts)
  // and needs its own GitHub OAuth app (one callback URL per app).
  "routes": [{ "pattern": "openinkeri.hokkanen.io", "custom_domain": true }],
  // Workers Logs: console output and uncaught errors, searchable in the
  // dashboard (Workers & Pages → openinkeri → Logs).
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openinkeri",
      // No database_id: `wrangler deploy` provisions the database on first
      // deploy and links it by name. Local dev uses a SQLite file in .wrangler/.
      // Drizzle 1.0 writes one folder per migration (migrations/<name>/migration.sql).
      "migrations_dir": "src/server/database/migrations",
      "migrations_pattern": "src/server/database/migrations/*/migration.sql",
    },
  ],
}
