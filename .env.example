# Server secret for signing session cookies (min. 32 chars).
# Generate one with: openssl rand -base64 32
# Comma-separated, newest first, to rotate secrets (see src/server/session.ts).
SESSION_SECRET=

# Optional: only needed to deploy from your machine with `pnpm run deploy`
# without `npx wrangler login`. Pushes to main deploy via Workers Builds.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
