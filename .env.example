# Secret for better-auth's session cookies and tokens (min. 32 chars).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app for sign-in: https://github.com/settings/developers
# (New OAuth App). Callback URL: http://localhost:3060/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: only needed to deploy from your machine with `pnpm run deploy`
# without `npx wrangler login`. Pushes to main deploy via Workers Builds.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: the app name shown in the sidebar and page titles
# (defaults to OpenInkeri in env.ts).
# VITE_APP_NAME=OpenInkeri
