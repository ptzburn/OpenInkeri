# Secret for better-auth's session cookies and tokens (min. 32 chars).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# GitHub OAuth app for sign-in: https://github.com/settings/developers
# (New OAuth App). Callback URL: http://localhost:3060/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Google and VK sign-in, each offered only when both of its values
# are set. Google: https://console.cloud.google.com/apis/credentials (OAuth
# client ID, Web application). Authorized redirect URI:
# http://localhost:3060/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VK: https://id.vk.com/about/business/go (VK ID, a Web app). Trusted
# redirect URL: http://localhost:3060/api/auth/callback/vk; the client
# secret is the app's protected key.
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=

# Optional: only needed to deploy from your machine with `pnpm run deploy`
# without `npx wrangler login`. Pushes to main deploy from GitHub Actions
# (.github/workflows/ci.yml).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional: the app name shown in the sidebar and page titles
# (defaults to OpenInkeri in env.ts).
# VITE_APP_NAME=OpenInkeri
